+package expo.modules.androidsmssender
+
+import android.app.Notification
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.app.Service
+import android.content.Context
+import android.content.Intent
+import android.os.BatteryManager
+import android.os.Build
+import android.os.IBinder
+import android.telephony.SubscriptionManager
+import androidx.core.app.NotificationCompat
+import androidx.core.content.ContextCompat
+
+// Service au premier plan : contrairement à la boucle JS (useJobPolling +
+// useHeartbeat, coupée dès que l'app passe en arrière-plan ou est fermée),
+// un foreground service est explicitement exempté des restrictions Android
+// de mise en veille (Doze, App Standby) tant que sa notification persistante
+// reste visible. C'est ce qui permet à l'envoi de SMS de continuer même
+// écran éteint / app fermée / juste après un redémarrage du téléphone
+// (démarré par BootReceiver).
+class SmsGatewayForegroundService : Service() {
+
+  private var workerThread: Thread? = null
+  @Volatile private var isRunning = false
+  private var smsSentCount = 0
+
+  override fun onCreate() {
+    super.onCreate()
+    createNotificationChannel()
+  }
+
+  override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
+    startForeground(NOTIFICATION_ID, buildNotification("En veille — en attente de SMS à envoyer"))
+
+    if (workerThread?.isAlive != true) {
+      isRunning = true
+      workerThread = Thread(::runLoop, "SmsGatewayWorker").apply { start() }
+    }
+
+    // START_STICKY : si le système tue le processus pour libérer de la mémoire,
+    // Android le relance automatiquement dès que possible (sans redemander de
+    // recréer l'Intent d'origine, ce qui est correct ici car tout ce dont on a
+    // besoin est déjà en SharedPreferences, pas dans l'Intent).
+    return START_STICKY
+  }
+
+  override fun onDestroy() {
+    isRunning = false
+    workerThread?.interrupt()
+    super.onDestroy()
+  }
+
+  override fun onBind(intent: Intent?): IBinder? = null
+
+  private fun runLoop() {
+    val prefs = SmsGatewayPrefs(applicationContext)
+    var lastHeartbeatAt = 0L
+
+    while (isRunning) {
+      val deviceToken = prefs.getDeviceToken()
+      val deviceId = prefs.getDeviceId()
+      val apiBaseUrl = prefs.getApiBaseUrl()
+
+      // Plus de token = téléphone dépairé entre-temps (voir DashboardScreen) :
+      // rien à faire, le service s'arrête de lui-même plutôt que de tourner à vide.
+      if (deviceToken.isNullOrEmpty() || deviceId.isNullOrEmpty() || apiBaseUrl.isNullOrEmpty()) {
+        stopSelf()
+        return
+      }
+
+      val client = SmsGatewayApiClient(apiBaseUrl, deviceToken)
+
+      try {
+        val now = System.currentTimeMillis()
+        if (now - lastHeartbeatAt >= HEARTBEAT_INTERVAL_MS) {
+          client.sendHeartbeat(getBatteryLevel())
+          lastHeartbeatAt = now
+        }
+
+        val jobs = client.getPendingJobs()
+        if (jobs.isNotEmpty()) {
+          val simSlotsByDeviceSimId = client.getDeviceSims(deviceId)
+          for (job in jobs) {
+            if (!isRunning) break
+            processJob(client, job, simSlotsByDeviceSimId)
+          }
+        }
+      } catch (e: Exception) {
+        // Ne jamais laisser une exception inattendue tuer le thread du
+        // service : le prochain cycle réessaiera.
+      }
+
+      try {
+        Thread.sleep(POLL_INTERVAL_MS)
+      } catch (e: InterruptedException) {
+        return
+      }
+    }
+  }
+
+  private fun processJob(
+    client: SmsGatewayApiClient,
+    job: SmsGatewayApiClient.PendingJob,
+    simSlotsByDeviceSimId: Map<Long, Int>,
+  ) {
+    val slotIndex = job.deviceSimId?.let { simSlotsByDeviceSimId[it] }
+    val subscriptionId = slotIndex?.let { resolveSubscriptionId(it) }
+
+    val result = SmsSendHelper.sendBlocking(applicationContext, job.recipient, job.content, subscriptionId)
+
+    if (result.success) {
+      smsSentCount++
+      updateNotification("$smsSentCount SMS envoyés depuis le démarrage")
+      client.reportJob(job.id, "sent", null, null)
+    } else {
+      client.reportJob(job.id, "failed", result.errorMessage ?: "Échec inconnu", null)
+    }
+  }
+
+  // Convertit un slot physique (0, 1...) en subscriptionId attendu par
+  // SmsManager — même mapping que getSimCards() côté JS (voir SimCard.kt),
+  // mais lu directement ici pour rester autonome du bridge React Native.
+  private fun resolveSubscriptionId(slotIndex: Int): Int? {
+    return try {
+      val subscriptionManager = getSystemService(Context.TELEPHONY_SUBSCRIPTION_SERVICE) as SubscriptionManager
+      subscriptionManager.activeSubscriptionInfoList
+        ?.firstOrNull { it.simSlotIndex == slotIndex }
+        ?.subscriptionId
+    } catch (e: SecurityException) {
+      null // Permission READ_PHONE_STATE révoquée entre-temps : repli sur la SIM par défaut.
+    }
+  }
+
+  private fun getBatteryLevel(): Int? {
+    val batteryManager = getSystemService(Context.BATTERY_SERVICE) as? BatteryManager ?: return null
+    val level = batteryManager.getIntProperty(BatteryManager.BATTERY_PROPERTY_CAPACITY)
+    return if (level in 0..100) level else null
+  }
+
+  private fun createNotificationChannel() {
+    if (Build.VERSION.SDK_INT < Build.VERSION_CODES.O) return
+
+    val channel = NotificationChannel(
+      CHANNEL_ID,
+      "SMS Gateway",
+      NotificationManager.IMPORTANCE_LOW, // silencieux : c'est un statut, pas une alerte
+    ).apply {
+      description = "Maintient l'envoi de SMS actif en arrière-plan"
+    }
+
+    val manager = getSystemService(NotificationManager::class.java)
+    manager?.createNotificationChannel(channel)
+  }
+
+  private fun buildNotification(contentText: String): Notification {
+    val launchIntent = packageManager.getLaunchIntentForPackage(packageName)
+    val pendingIntent = launchIntent?.let {
+      PendingIntent.getActivity(this, 0, it, PendingIntent.FLAG_IMMUTABLE)
+    }
+
+    return NotificationCompat.Builder(this, CHANNEL_ID)
+      .setContentTitle("Passerelle SMS active")
+      .setContentText(contentText)
+      .setSmallIcon(android.R.drawable.stat_sys_upload)
+      .setOngoing(true)
+      .setContentIntent(pendingIntent)
+      .setPriority(NotificationCompat.PRIORITY_LOW)
+      .build()
+  }
+
+  private fun updateNotification(contentText: String) {
+    val manager = getSystemService(NotificationManager::class.java)
+    manager?.notify(NOTIFICATION_ID, buildNotification(contentText))
+  }
+
+  companion object {
+    private const val CHANNEL_ID = "sms_gateway_background"
+    private const val NOTIFICATION_ID = 4821
+    private const val POLL_INTERVAL_MS = 15_000L
+    private const val HEARTBEAT_INTERVAL_MS = 30_000L
+
+    fun start(context: Context) {
+      val intent = Intent(context, SmsGatewayForegroundService::class.java)
+      ContextCompat.startForegroundService(context, intent)
+    }
+
+    fun stop(context: Context) {
+      context.stopService(Intent(context, SmsGatewayForegroundService::class.java))
+    }
+  }
+}
