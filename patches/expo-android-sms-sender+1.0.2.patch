+/**
+ * Démarre le service Android au premier plan qui continue de recevoir et
+ * d'envoyer les SMS en attente même quand l'app est fermée ou le téléphone
+ * verrouillé, et le relance automatiquement après un redémarrage du téléphone.
+ *
+ * @param deviceToken Le token de ce device pairé (voir deviceStorage).
+ * @param deviceId L'identifiant du device côté backend.
+ * @param apiBaseUrl L'URL de base de l'API (voir API_BASE_URL).
+ */
+export async function startBackgroundService(
+  deviceToken: string,
+  deviceId: string,
+  apiBaseUrl: string
+): Promise<void> {
+  await ExpoAndroidSmsSenderModule.startBackgroundService(deviceToken, deviceId, apiBaseUrl);
+}
+
+/**
+ * Arrête le service en arrière-plan et efface les identifiants natifs
+ * persistés — à appeler au dépairage du téléphone (jamais à la simple
+ * déconnexion du compte utilisateur, qui doit laisser le pairing intact).
+ */
+export async function stopBackgroundService(): Promise<void> {
+  await ExpoAndroidSmsSenderModule.stopBackgroundService();
+}
+
+/**
+ * Indique si un device_token a été persisté nativement (donc si le service
+ * en arrière-plan est censé tourner / se relancera après un redémarrage).
+ */
+export async function isBackgroundServiceConfigured(): Promise<boolean> {
+  return ExpoAndroidSmsSenderModule.isBackgroundServiceConfigured();
+}
 
