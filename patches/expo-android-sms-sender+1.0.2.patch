+package expo.modules.androidsmssender
+
+import android.content.Context
+
+private const val PREFS_NAME = "sms_gateway_background_prefs"
+private const val KEY_DEVICE_TOKEN = "device_token"
+private const val KEY_DEVICE_ID = "device_id"
+private const val KEY_API_BASE_URL = "api_base_url"
+
+// SharedPreferences plutôt que expo-secure-store : le service au premier plan
+// tourne dans un contexte natif indépendant du pont React Native — parfois
+// avant même que le JS ait démarré, par ex. juste après un redémarrage du
+// téléphone via BootReceiver — et doit pouvoir lire ces valeurs de façon
+// synchrone, sans invoquer le bridge. Le device_token reste un secret à
+// portée limitée (un seul téléphone, révocable à tout moment depuis le
+// dashboard web), donc ce compromis simplicité/sécurité est raisonnable ici.
+class SmsGatewayPrefs(context: Context) {
+  private val prefs = context.applicationContext.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+
+  fun hasDeviceToken(): Boolean = !getDeviceToken().isNullOrEmpty()
+
+  fun getDeviceToken(): String? = prefs.getString(KEY_DEVICE_TOKEN, null)
+
+  fun getDeviceId(): String? = prefs.getString(KEY_DEVICE_ID, null)
+
+  fun getApiBaseUrl(): String? = prefs.getString(KEY_API_BASE_URL, null)
+
+  fun save(deviceToken: String, deviceId: String, apiBaseUrl: String) {
+    prefs.edit()
+      .putString(KEY_DEVICE_TOKEN, deviceToken)
+      .putString(KEY_DEVICE_ID, deviceId)
+      .putString(KEY_API_BASE_URL, apiBaseUrl)
+      .apply()
+  }
+
+  // Appelé à la déconnexion / dépairage : arrête toute tentative d'envoi
+  // ultérieure (le service se coupe de lui-même dès qu'il ne trouve plus de
+  // token au prochain cycle, voir SmsGatewayForegroundService).
