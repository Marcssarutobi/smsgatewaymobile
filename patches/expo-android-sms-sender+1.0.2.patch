+package expo.modules.androidsmssender
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+
+// Reçoit BOOT_COMPLETED (déclaré dans AndroidManifest.xml de ce module) et
+// relance automatiquement le service au premier plan, pour que ce téléphone
+// reprenne son rôle de passerelle SMS sans que quiconque ait besoin de
+// rouvrir l'app après un redémarrage.
+class BootReceiver : BroadcastReceiver() {
+  override fun onReceive(context: Context, intent: Intent) {
+    if (intent.action != Intent.ACTION_BOOT_COMPLETED) return
+
+    // Ne démarre que si ce téléphone a déjà été pairé au moins une fois —
+    // sinon rien à faire tant que l'app n'a pas été configurée manuellement.
+    val prefs = SmsGatewayPrefs(context)
+    if (!prefs.hasDeviceToken()) return
+
+    SmsGatewayForegroundService.start(context)
+  }
+}
