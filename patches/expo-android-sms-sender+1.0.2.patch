+package expo.modules.androidsmssender
+
+import org.json.JSONArray
+import org.json.JSONObject
+import java.net.HttpURLConnection
+import java.net.URL
+import java.io.OutputStreamWriter
+
+// Client HTTP minimal (HttpURLConnection + org.json, tous deux inclus dans le
+// SDK Android — zéro dépendance Gradle supplémentaire à faire compiler) pour
+// que le service en arrière-plan puisse parler au backend indépendamment
+// d'axios/JS. Reproduit exactement les 3 appels déjà utilisés côté JS
+// (voir jobService.ts et deviceService.ts) avec le même contrat.
+class SmsGatewayApiClient(private val baseUrl: String, private val deviceToken: String) {
+
+  data class PendingJob(val id: Long, val deviceSimId: Long?, val recipient: String, val content: String)
+
+  fun getPendingJobs(): List<PendingJob> {
+    val response = request("GET", "/device/jobs/pending", null) ?: return emptyList()
+    val jobsArray = JSONObject(response).optJSONArray("jobs") ?: JSONArray()
+
+    return (0 until jobsArray.length()).map { i ->
+      val job = jobsArray.getJSONObject(i)
+      PendingJob(
+        id = job.getLong("id"),
+        deviceSimId = if (job.isNull("device_sim_id")) null else job.getLong("device_sim_id"),
+        recipient = job.getString("recipient"),
+        content = job.getString("content"),
+      )
+    }
+  }
+
+  fun reportJob(jobId: Long, status: String, errorMessage: String?, deviceSimId: Long?) {
+    val body = JSONObject().apply {
+      put("status", status)
+      if (errorMessage != null) put("error_message", errorMessage)
+      if (deviceSimId != null) put("device_sim_id", deviceSimId)
+    }
+    request("POST", "/device/jobs/$jobId/report", body)
+  }
+
+  fun sendHeartbeat(batteryLevel: Int?) {
+    val body = JSONObject().apply {
+      if (batteryLevel != null) put("battery_level", batteryLevel)
+    }
+    request("POST", "/device/heartbeat", body)
+  }
+
+  // Nécessaire pour retrouver le slot_index correspondant au device_sim_id
+  // renvoyé par un job (voir GET /devices/{id} déjà utilisé côté JS).
+  fun getDeviceSims(deviceId: String): Map<Long, Int> {
+    val response = request("GET", "/devices/$deviceId", null) ?: return emptyMap()
+    val sims = JSONObject(response).optJSONArray("sims") ?: JSONArray()
+
+    return (0 until sims.length()).associate { i ->
+      val sim = sims.getJSONObject(i)
+      sim.getLong("id") to sim.getInt("slot_index")
+    }
+  }
+
+  private fun request(method: String, path: String, body: JSONObject?): String? {
+    return try {
+      val url = URL(baseUrl.trimEnd('/') + path)
+      val connection = url.openConnection() as HttpURLConnection
+      connection.requestMethod = method
+      connection.setRequestProperty("Authorization", "Bearer $deviceToken")
+      connection.setRequestProperty("Accept", "application/json")
+      connection.connectTimeout = 15_000
+      connection.readTimeout = 15_000
+
+      if (body != null) {
+        connection.doOutput = true
+        connection.setRequestProperty("Content-Type", "application/json")
+        OutputStreamWriter(connection.outputStream).use { it.write(body.toString()) }
+      }
+
+      val code = connection.responseCode
+      val stream = if (code in 200..299) connection.inputStream else connection.errorStream
+      val text = stream?.bufferedReader()?.use { it.readText() }
+
+      if (code !in 200..299) null else text
+    } catch (e: Exception) {
+      // Coupure réseau, serveur injoignable, timeout... le prochain cycle de
+      // la boucle du service réessaiera — jamais fatal pour le service lui-même.
+      null
+    }
+  }
+}
