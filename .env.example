# URL de l'API backend (Laravel), avec le préfixe /api.
# En dev, utilisez l'IP locale de votre machine sur le réseau Wi-Fi (pas "localhost",
# le téléphone ne pourrait pas la joindre) : ex. http://192.168.1.42:8000/api
# En prod/staging, utilisez l'URL publique du backend déployé.
EXPO_PUBLIC_API_URL=http://192.168.100.7:8000/api

# ID client OAuth "Web" (Google Cloud Console > Identifiants > ID client OAuth 2.0 >
# type "Application Web"). Doit être IDENTIQUE à GOOGLE_WEB_CLIENT_ID côté backend.
# ⚠️ Nécessite un dev build ou un build EAS : ne fonctionne pas dans Expo Go
# (le service de proxy Expo pour OAuth n'existe plus).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
